---
/**
 * Shared page chrome (nav structure identical across sections; only
 * the active-link accent flexes — coral for vocabulary, plum for grammar).
 */
import '../styles/global.css';
import ProfileChip from '../components/profile/ProfileChip';
import ProfileGate from '../components/profile/ProfileGate';
import SaveButton from '../components/profile/SaveButton';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** Which nav item is active — drives the accent color of that item only. */
  section?: 'vocabulary' | 'grammar' | 'progress' | 'about' | null;
  /** Study surfaces require a loaded profile. */
  requireProfile?: boolean;
}

const { title, description, section = null, requireProfile = false } = Astro.props;

const ogImage = new URL(withBase('/og-image.png'), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// First-commit year, from `git log --reverse`. Pinned rather than queried at build time:
// it can never change, and CI checkouts are shallow (git history isn't there to query).
const COPYRIGHT_START_YEAR = 2026;
const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > COPYRIGHT_START_YEAR ? `${COPYRIGHT_START_YEAR}-${currentYear}` : `${COPYRIGHT_START_YEAR}`;

const navItems = [
  { key: 'vocabulary', label: 'Vocabulary', short: 'Vocab', href: withBase('/vocabulary/'), activeClass: 'text-vocab bg-vocab-soft' },
  { key: 'grammar', label: 'Grammar', short: 'Grammar', href: withBase('/grammar/'), activeClass: 'text-grammar bg-grammar-soft' },
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Theme init before first paint — user toggle wins, else system preference.
      // theme-color follows the RESOLVED theme, not prefers-color-scheme, because the
      // toggle can disagree with the system setting.
      (() => {
        const stored = localStorage.getItem('lalista:theme');
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#17171f' : '#fafaf7');
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TH5G240G6K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-TH5G240G6K');
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <nav class="flex items-center justify-between gap-1 border-b border-border bg-surface-raised px-2.5 py-3 sm:px-8 sm:py-4">
      <a href={withBase('/')} class="font-display text-xl font-semibold no-underline sm:text-2xl">
        <span class="wordmark-gradient">¡LaLista!</span>
      </a>
      <div class="flex items-center gap-0.5 sm:gap-3">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-pill px-2 py-1.5 text-[0.82rem] font-semibold no-underline sm:px-3 sm:py-2 sm:text-sm',
                section === item.key ? item.activeClass : 'text-ink-soft hover:text-ink',
              ]}
            >
              <span class="sm:hidden">{item.short}</span>
              <span class="hidden sm:inline">{item.label}</span>
            </a>
          ))
        }
        <ProfileChip client:load active={section === 'progress'} />
        <a
          href={withBase('/about/')}
          title="About LaLista"
          aria-label="About LaLista"
          class:list={[
            'flex h-9 w-9 shrink-0 items-center justify-center rounded-pill border border-border no-underline sm:h-10 sm:w-10',
            section === 'about' ? 'bg-surface-sunken text-ink' : 'bg-surface-base text-ink-soft hover:text-ink',
          ]}
        >
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v-6"></path>
            <path d="M12 7.5h.01"></path>
          </svg>
        </a>
        <SaveButton client:load />
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="ml-1 flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-pill border border-border bg-surface-base text-ink-soft hover:text-ink sm:h-10 sm:w-10"
        >
          {/* Sun shown in dark mode ("switch to light"), moon in light mode */}
          <svg class="theme-icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="theme-icon-sun h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
          </svg>
        </button>
      </div>
    </nav>

    {requireProfile && <ProfileGate client:load />}
    <slot />

    <footer class="mt-auto border-t border-border px-8 py-4 text-center text-xs leading-relaxed text-ink-faint">
      <p class="m-0">
        LaLista is free, ad-free and account-free (<a href={withBase('/about/')} class="font-semibold text-ink-soft underline">about the project</a>).
        © {copyrightYears} Kiarash Farajzadehahary.
      </p>
      <p class="m-0">
        Definitions informed by WordReference and the RAE. Pronunciations by Lingua Libre volunteers (CC BY 4.0) and Piper TTS (<a href={withBase('/credits/')} class="font-semibold text-ink-soft underline">full credits</a>).
      </p>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem('lalista:theme', next);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', next === 'dark' ? '#17171f' : '#fafaf7');
      });
    </script>

    <style>
      /* Icon swap follows the CURRENT theme */
      .theme-icon-sun {
        display: none;
      }
      :global([data-theme='dark']) .theme-icon-moon {
        display: none;
      }
      :global([data-theme='dark']) .theme-icon-sun {
        display: block;
      }
    </style>
  </body>
</html>
